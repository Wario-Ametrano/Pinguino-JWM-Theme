! Wario Cyberpunk 
xterm*background: #000000
xterm*foreground: #ffffff
xterm*cursorColor: #638dcf

! Colori ANSI Standard (0-7)
xterm*color0:  #000000
xterm*color1:  #FF0055
xterm*color2:  #638dcf
xterm*color3:  #F4EF00
xterm*color4:  #dadada
xterm*color5:  #D57BFF
xterm*color6:  #FFFFFF
xterm*color7:  #9a9c9c

xterm*termName: xterm-256color

! Colori BRIGHT (8-15)
xterm*color8:  #777777
xterm*color9:  #FF4081
xterm*color10: #00FF9C
xterm*color11: #dadada
xterm*color12: #76C1FF
xterm*color13: #638dcf
xterm*color14: #00FFC8
xterm*color15: #9a9c9c

!IMPOSTAZIONI FUNZIONALITA-----------------------------

! IMPOSTAZIONI CURSORE
xterm*cursorBlink: always
XTerm*blinkInterval: 500
XTerm*cursorThickness: 1
xterm*pointerShape: left_ptr
xterm*scrollBar: false
xterm*saveLines: 2000

! Impostazioni Font e Rendering
xterm*faceName: JetBrainsMono Nerd Font Mono:style=Regular
xterm*faceNameBold: JetBrainsMono Nerd Font Mono:style=Bold
xterm*faceSize: 11
xterm*geometry: 65x18
xterm*renderFont: true

! Codifica e Localizzazione
xterm*utf8: 1
xterm*locale: true

! Supporto Grafico Sixel
decTerminalID: vt220

Xcursor.theme: Notwaita-Black
Xcursor.size: 25

XTerm*vt100.internalBorder: 0
XTerm*borderWidth: 0
!xrdb -merge ~/.Xresources
